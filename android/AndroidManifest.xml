<?xml version="1.0" encoding="utf-8"?>
<!--
  pygame-rs-runtime Android 清单（**NativeActivity 自管理形态**）：
  android.app.NativeActivity 是系统自带 Activity，dlopen lib/<lib_name>.so
  并调用导出的 android_main——无自有 Java/Kotlin、无代码注入、无 surface/
  事件注入（starfish-we 经 android_native_app_glue 自管窗口与输入）。
  脚本/资源 = 加密 SFIX1 包**追加在 .so 尾部**（启动自读，与桌面 trailer
  同源）；hasCode=false = 纯原生（无 dex）。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.starfish.runtime"
    android:versionCode="1"
    android:versionName="0.1.0">

    <!-- minSdk 26：cpal AAudio 硬性下限（NDK 的 libaaudio 仅 API 26+ 提供） -->
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="36" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 诊断日志写 /sdcard/Download（legacy 授予——崩溃取证通道） -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <!-- wgpu GLES 后端兜底需 GLES 3.x；支持 Vulkan 的设备自动走 Vulkan -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:label="__GAME_NAME__"
        android:hasCode="false"
        android:requestLegacyExternalStorage="true"
        android:extractNativeLibs="true">

        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:launchMode="singleInstance"
            android:screenOrientation="__ORIENTATION__"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:theme="@style/StarfishTheme">
            <meta-data
                android:name="android.app.lib_name"
                android:value="__LIB_NAME__" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
