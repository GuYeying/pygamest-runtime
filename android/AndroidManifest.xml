<?xml version="1.0" encoding="utf-8"?>
<!--
  pygame-rs-runtime Android 清单（**Java 宿主 + JNI 嵌入面**——卓易通
  兼容形态，2026-11-08 定约）：兼容层对标准 Java Activity 支持最好
  （pygamest-dev 同形态真机实证完美）；NativeActivity 纯原生形态在
  卓易通秒闪退（实测）。hasCode=true（dex）+ MainActivity 全屏
  SurfaceView → JNI attachSurface/runEmbedded；入口 main.py 密文仍
  嵌 .so（build.rs 编译期），APK assets/ = 加密散件（Java 递归拷
  filesDir 后 io 哈希链直达——桌面 dist 同构布局）。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.starfish.runtime"
    android:versionCode="1"
    android:versionName="0.1.0">

    <!-- minSdk 26：cpal AAudio 硬性下限（NDK 的 libaaudio 仅 API 26+ 提供） -->
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="36" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 诊断日志写 /sdcard/Download（legacy 授予——崩溃取证通道） -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <!-- wgpu GLES 后端兜底需 GLES 3.x；支持 Vulkan 的设备自动走 Vulkan -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:label="__GAME_NAME__"
        android:hasCode="true"
        android:requestLegacyExternalStorage="true"
        android:extractNativeLibs="true">

        <activity
            android:name="com.starfish.runtime.MainActivity"
            android:exported="true"
            android:launchMode="singleInstance"
            android:screenOrientation="__ORIENTATION__"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:theme="@style/StarfishTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
